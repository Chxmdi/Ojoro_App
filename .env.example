NODE_ENV=development
APP_ENV=local
APP_VERSION=dev

# Database / cache
DATABASE_URL=
REDIS_URL=

# Supabase (server side only: apps/api, scripts, Edge Function secrets).
# Local values come from `supabase status -o env` after `supabase start`.
# SUPABASE_SERVICE_ROLE_KEY (or a `sb_secret_...` secret key) bypasses row-level security:
# never ship it in the mobile app, never prefix it with EXPO_PUBLIC_, never commit a real value.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# Feature flags
FEATURE_FLAG_PROVIDER=

# Deployment values are configured in GitHub Environments / Actions secrets,
# never committed here.
