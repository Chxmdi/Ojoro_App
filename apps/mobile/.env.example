# Public config for the Expo app. Copy to apps/mobile/.env (git-ignored) and fill in.
# Everything prefixed EXPO_PUBLIC_ is inlined into the app bundle and readable by anyone who has
# the app, so only public values belong here. Never put a service_role or `sb_secret_...` key here.
#
# Local: run `pnpm dlx supabase@latest start` at the repo root, then copy API_URL and
# PUBLISHABLE_KEY from `supabase status`. On a device or emulator, use your machine's LAN IP
# instead of 127.0.0.1 (Android emulator: 10.0.2.2).
# Hosted: Project Settings > API Keys in the Supabase dashboard (`sb_publishable_...`).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
