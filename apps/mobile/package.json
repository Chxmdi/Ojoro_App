{
  "name": "@ojoro/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "storybook": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start",
    "storybook:web": "EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --web",
    "storybook:generate": "sb-rn-get-stories --config-path .rnstorybook",
    "lint": "eslint src app.config.ts metro.config.js postcss.config.mjs --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src --passWithNoTests",
    "build": "expo export --platform web --output-dir dist",
    "doctor": "pnpm dlx expo-doctor@latest",
    "eas:build:dev": "pnpm dlx eas-cli@latest build --profile development --platform all",
    "eas:build:preview": "pnpm dlx eas-cli@latest build --profile preview --platform all",
    "eas:build:production": "pnpm dlx eas-cli@latest build --profile production --platform all",
    "eas:update:preview": "pnpm dlx eas-cli@latest update --channel preview",
    "eas:update:production": "pnpm dlx eas-cli@latest update --channel production",
    "eas:submit:production": "pnpm dlx eas-cli@latest submit --profile production --platform all"
  },
  "dependencies": {
    "@expo-google-fonts/anton": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@ojoro/analytics": "workspace:*",
    "@ojoro/contracts": "workspace:*",
    "@ojoro/design-tokens": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/query-async-storage-persister": "^5.105.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-persist-client": "^5.105.0",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.22",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "nativewind": "5.0.0-rc.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css": "3.1.0-rc.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@storybook/addon-ondevice-actions": "^10.7.0",
    "@storybook/addon-ondevice-controls": "^10.7.0",
    "@storybook/react-native": "^10.7.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "~19.2.2",
    "postcss": "^8.5.32",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3"
  }
}
