# Edge Function secrets for the payments functions (docs/PAYMENTS_CONTRACT.md §Configuration).
# NAMES ONLY: never commit values. Hosted: `supabase secrets set NAME=value`. Local: copy to
# supabase/functions/.env (git-ignored) with TEST values; see §Local development.
#
# TEST MODE ONLY: live keys (sk_live_, rk_live_) and STRIPE_MODE other than test are refused.

# Stripe secret key: sk_test_… (or a restricted rk_test_…).
STRIPE_SECRET_KEY=
# Signing secret of the platform webhook endpoint (<functions>/stripe-webhook): whsec_…
STRIPE_WEBHOOK_SECRET=
# Optional: signing secret of the Connect webhook endpoint (account.updated, payout.*): whsec_…
STRIPE_CONNECT_WEBHOOK_SECRET=
# Must be test.
STRIPE_MODE=test
# Optional: stripe-mock for local runs, e.g. http://host.docker.internal:12111
STRIPE_API_BASE=
# Optional: country of new Express accounts (default CA).
STRIPE_CONNECT_COUNTRY=
# Guards payments-drain; the same value goes in the Vault as payments_drain_secret.
PAYMENTS_CRON_SECRET=
# Public base of the functions, for Stripe's return links: https://<ref>.supabase.co/functions/v1
PAYMENTS_FUNCTIONS_URL=
# App bases Stripe's return links may go back to, comma-separated (default ojoro://).
PAYMENTS_RETURN_ORIGINS=
